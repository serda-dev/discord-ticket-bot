{
	"name": "discord-tickets",
	"version": "5.0.0-alpha.0",
	"private": true,
	"description": "The most popular open-source ticket management bot for Discord.",
	"keywords": [
		"bot",
		"discord",
		"tickets"
	],
	"homepage": "https://discordtickets.app",
	"bugs": {
		"url": "https://github.com/discord-tickets/bot/issues"
	},
	"license": "GPL-3.0-or-later",
	"author": "eartharoid",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/discord-tickets/bot.git"
	},
	"workspaces": {
		"catalog": {
			"typescript": "7",
			"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
			"vite-plus": "0.3.0",
			"wrangler": "^4.125.0"
		},
		"packages": [
			"packages/*",
			"workers/*"
		]
	},
	"scripts": {
		"changelog": "vp run conventional-changelog -p angular -i CHANGELOG.md -s",
		"contributors:add": "vp run all-contributors add",
		"contributors:generate": "vp run all-contributors generate",
		"prepare": "vp hooks enable"
	},
	"devDependencies": {
		"@commitlint/cli": "^17.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"all-contributors-cli": "^6.26.1",
		"conventional-changelog-cli": "^5.0.0",
		"lint-staged": "^15.5.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {},
	"optionalDependencies": {},
	"overrides": {
		"vite": "catalog:"
	},
	"lint-staged": {
		"*.md": "bun lint",
		"{packages,services}/**/*.{js,ts}": "bun lint"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0",
			"onFail": "download"
		}
	}
}
